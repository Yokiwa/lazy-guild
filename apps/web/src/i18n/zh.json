      "skipped": [
        "今天就到这里吧，狐火会替你守着。",
        "偶尔休息，是聪明的冒险者才懂的事。",
        "明天的布告栏，我先替你占个位子。"
      ],
      "levelUp": [
        "又强了一些呢，我很欣慰。",
        "升级了。这条路你走得不错。",
        "新的等级，新的风景。"
      ],
      "evolve": [
        "……尾巴又多了一条。都是托你的福。",
        "狐火的颜色变了，你注意到了吗？",
        "我们，都在长大呢。"
      ],
      "rest": [
        "昨天用了休息券，连续天数还在，放心。",
        "在旅店歇过了，精神不错吧？",
        "休息是为了走更远的路。"
      ]
    },
